{
  "name": "navopath",
  "version": "1.2.3",
  "description": "NavoPath — Navigate your next step.",
  "author": "NavoPath",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "build": "npm run build:navopath",
    "build:navopath": "tsc && vite build",
    "test": "node --test supabase/functions/ai-assistant/conversation.test.ts && vitest run src/syncBootstrap.test.ts src/utils/todayCandidates.test.ts",
    "build:portfolio": "tsc && vite build --config vite.portfolio.config.ts",
    "preview:portfolio": "vite preview --config vite.portfolio.config.ts --host 127.0.0.1",
    "dist": "npm run build && electron-builder --win nsis portable",
    "preview": "vite preview --host 127.0.0.1",
    "size": "npm run build && size-limit",
    "size:check": "size-limit"
  },
  "size-limit": [
    {
      "name": "Core app scripts",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/react-vendor-*.js",
        "dist/assets/supabase-vendor-*.js",
        "dist/assets/PlanningView-*.js",
        "dist/assets/LandingPage-*.js",
        "dist/assets/supabasePlannerApi-*.js",
        "dist/assets/aiAssistantApi-*.js"
      ],
      "limit": "230 KB"
    },
    {
      "name": "Document parsing scripts",
      "path": [
        "dist/assets/fileParser-*.js",
        "dist/assets/pdf.worker.min-*.mjs"
      ],
      "limit": "700 KB"
    },
    {
      "name": "Styles",
      "path": "dist/assets/index-*.css",
      "limit": "80 KB"
    }
  ],
  "build": {
    "appId": "com.local.admission.goal.calendar",
    "productName": "NavoPath",
    "afterPack": "scripts/brand-electron-build.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "NavoPath",
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "NavoPath",
      "uninstallDisplayName": "NavoPath",
      "artifactName": "NavoPath-Setup.exe"
    },
    "portable": {
      "artifactName": "NavoPath-Portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "shawn89890916",
      "repo": "NavoPath-planner",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@size-limit/file": "^12.1.0",
    "@supabase/supabase-js": "^2.107.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.0.227",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^12.1.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1",
    "wrangler": "^4.101.0"
  }
}
