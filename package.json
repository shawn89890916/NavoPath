{
  "name": "navopath",
  "version": "1.3.8",
  "description": "NavoPath — Navigate your next step.",
  "author": "NavoPath",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "build": "npm run build:navopath",
    "build:navopath": "tsc && vite build",
    "test": "node --test \"supabase/functions/ai-assistant/*.test.ts\" \"electron/*.test.cjs\" && vitest run src",
    "test:calendar": "vitest run src/calendarFeed.test.ts",
    "build:portfolio": "tsc && vite build --config vite.portfolio.config.ts",
    "preview:portfolio": "vite preview --config vite.portfolio.config.ts --host 127.0.0.1",
    "dist": "npm run build && electron-builder --win nsis portable",
    "preview": "vite preview --host 127.0.0.1",
    "mobile:preview": "vite --host 0.0.0.0",
    "ios:sync": "npm run build && cap sync ios && node scripts/normalize-capacitor-spm-paths.mjs",
    "ios:check": "node scripts/normalize-capacitor-spm-paths.mjs --check",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "size": "npm run build && size-limit",
    "size:check": "size-limit"
  },
  "size-limit": [
    {
      "name": "Initial app scripts",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/react-vendor-*.js",
        "dist/assets/supabase-vendor-*.js",
        "dist/assets/supabasePlannerApi-*.js"
      ],
      "limit": "232 KB"
    },
    {
      "name": "Deferred app scripts",
      "path": [
        "dist/assets/PlanningView-*.js",
        "dist/assets/LandingPage-*.js",
        "dist/assets/WidgetApp-*.js",
        "dist/assets/MobileTaskSummary-*.js"
      ],
      "limit": "35 KB"
    },
    {
      "name": "Total app scripts",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/react-vendor-*.js",
        "dist/assets/supabase-vendor-*.js",
        "dist/assets/supabasePlannerApi-*.js",
        "dist/assets/PlanningView-*.js",
        "dist/assets/LandingPage-*.js",
        "dist/assets/WidgetApp-*.js",
        "dist/assets/MobileTaskSummary-*.js"
      ],
      "limit": "267 KB"
    },
    {
      "name": "Document parsing scripts",
      "path": [
        "dist/assets/fileParser-*.js",
        "dist/assets/pdf.worker.min-*.mjs"
      ],
      "limit": "700 KB"
    },
    {
      "name": "Core styles",
      "path": "dist/assets/index-*.css",
      "limit": "85 KB"
    },
    {
      "name": "Deferred styles",
      "path": [
        "dist/assets/LandingPage-*.css",
        "dist/assets/WidgetApp-*.css",
        "dist/assets/MobileTaskSummary-*.css"
      ],
      "limit": "12 KB"
    },
    {
      "name": "Total styles",
      "path": [
        "dist/assets/index-*.css",
        "dist/assets/LandingPage-*.css",
        "dist/assets/WidgetApp-*.css",
        "dist/assets/MobileTaskSummary-*.css"
      ],
      "limit": "96 KB"
    }
  ],
  "build": {
    "appId": "com.local.admission.goal.calendar",
    "productName": "NavoPath",
    "afterPack": "scripts/brand-electron-build.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "D:/navopath-build"
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "NavoPath",
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "NavoPath",
      "uninstallDisplayName": "NavoPath",
      "artifactName": "NavoPath-Setup.exe"
    },
    "portable": {
      "artifactName": "NavoPath-Portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "shawn89890916",
      "repo": "NavoPath-planner",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/status-bar": "^8.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.24.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@cloudflare/workers-types": "^5.20260726.1",
    "@size-limit/file": "^12.1.0",
    "@supabase/supabase-js": "^2.107.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "19.1.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.7",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.0.227",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-test-renderer": "19.2.6",
    "size-limit": "^12.1.0",
    "terser": "^5.49.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "js-yaml": "5.2.2"
  }
}
